# ==============================================================================
# FIELDNOTES JOURNAL - GIT IGNORE RULES
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
build/
*.tsbuildinfo

# Environment variables & secrets
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Permanently exclude deleted root .env.example
/.env.example

# Uploaded user media assets (preserve directory via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Ephemeral testing directories & profiles
chrome_test_profile/
theme_screenshots/
regression_screenshots/

# Logs, diagnostics & debug traces
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage & reports
coverage/
.nyc_output/

# OS-generated metadata
.DS_Store
Thumbs.db
