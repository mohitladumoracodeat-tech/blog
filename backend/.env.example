# Backend Environment Configuration Template
NODE_ENV=production
PORT=4000
DATABASE_URL="mysql://blog_user:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:3306/blog_management"
DATABASE_SSL=false
CORS_ORIGINS=https://yourdomain.com
PUBLIC_SITE_URL=https://yourdomain.com
JWT_ACCESS_SECRET=REPLACE_WITH_A_SECURE_RANDOM_32_PLUS_CHAR_SECRET
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
TRUST_PROXY=1
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.yourdomain.com
# UPLOAD_DIR=/var/data/blog-uploads
LOG_LEVEL=info

# Outbound Production SMTP Settings (Optional in dev, required for live email)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# SMTP_FROM="Fieldnotes Journal <no-reply@fieldnotes.journal>"

# Machine Translation Provider (none | gemini | deepl | libretranslate | google-cloud | mock)
TRANSLATION_PROVIDER=none
# GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
# GEMINI_MODEL=gemini-3.5-flash-lite
