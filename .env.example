# ==============================================================================
# BLOG MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure the variables for your target environment.
# NEVER commit production .env files containing real passwords or secrets to Git!
# ==============================================================================

# Server Runtime Environment (development | test | production)
NODE_ENV=production

# Backend HTTP Server Port
PORT=4000

# MySQL Database Connection String
# Format: mysql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL="mysql://blog_user:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:3306/blog_management"

# Database TLS/SSL (Set to "true" for managed cloud databases requiring TLS)
DATABASE_SSL=false

# Allowed CORS Origins (Comma-separated list of authorized frontend origins)
# In production, specify your exact domain (e.g., https://yourdomain.com)
CORS_ORIGINS=https://yourdomain.com

# Public Site Canonical Base URL (Used for sitemap.xml, robots.txt, and canonical meta tags)
# In production, must be your live domain with HTTPS
PUBLIC_SITE_URL=https://yourdomain.com

# JWT Secret (MUST be at least 32 cryptographically random characters)
# Generate with: openssl rand -base64 36
JWT_ACCESS_SECRET=REPLACE_WITH_A_SECURE_RANDOM_32_PLUS_CHAR_SECRET

# JWT Token Expirations
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Reverse Proxy Trust (Set to "1" or "true" when behind Nginx, AWS ALB, Cloudflare, etc.)
# Ensures rate limiting and client IP tracking inspect X-Forwarded-For correctly.
TRUST_PROXY=1

# Cookie Settings (Production defaults: secure=true, sameSite=lax)
# COOKIE_DOMAIN=.yourdomain.com   # Optional: set for cross-subdomain authentication
# COOKIE_SECURE=true              # Optional override: defaults to true in production
COOKIE_SAME_SITE=lax

# Custom File Upload Storage Directory (Optional)
# Defaults to "./uploads" inside the backend directory.
# Useful for Docker persistent volumes or mounted storage disks (e.g., /var/data/uploads).
# UPLOAD_DIR=/var/data/blog-uploads

# Logging Verbosity (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# Frontend API Base URL.
# When the frontend is served on the same domain as the backend behind an Nginx reverse proxy,
# leave empty or set to /api/v1.
# When hosted on a separate subdomain (e.g. api.yourdomain.com), set to https://api.yourdomain.com/api/v1
VITE_API_URL=/api/v1
